APP_NAME=UOMi

# development | staging | production
# production makes the API refuse to start with unsafe settings (the console SMS backend, DEBUG=true, a
# placeholder SECRET_KEY, no OTP_HMAC_KEY, CORS origins that are not https://) and turns off /docs.
ENVIRONMENT=development
DEBUG=false

# SQLite for development. PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./uomi.db

# Browser origins allowed to call the API (the Expo web build), comma separated.
# In production: delete this line (nothing is allowed) or list exact https:// origins.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# REQUIRED. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Production only: a SECOND random key (32+ characters, different from SECRET_KEY) for the texted codes.
# Leave empty in development.
OTP_HMAC_KEY=

# --- Sign-in session ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=10

# --- Sign-in lockout ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_PER_IP=30

# --- Forgot password ---
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=3
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_SESSION_TIMEOUT_MINUTES=10

# --- Rate limits (counted in memory, per API process) ---
REGISTER_MAX_PER_IP_PER_HOUR=20
FORGOT_MAX_PER_IP_PER_HOUR=10
VERIFY_OTP_MAX_PER_IP_PER_HOUR=30
SEARCH_MAX_PER_USER_PER_MINUTE=120
SEARCH_MAX_PER_IP_PER_MINUTE=240
PHONE_LOOKUPS_PER_USER_PER_HOUR=20
# The most codes (texts) the whole API creates per UTC day. Also set a spend limit at the SMS provider.
SMS_DAILY_CAP=1000
# How many proxies / load balancers sit in front of the API (0 = none). Needed for the per-address limits.
TRUSTED_PROXY_COUNT=0

DEFAULT_COUNTRY_CODE=+91
DEFAULT_CURRENCY=INR

# console = the text message is printed in the server output (development)
SMS_BACKEND=console

# true = the API process sends payment reminders once a day (days 3, 5, 7 and 10 after a share is accepted)
REMINDERS_ENABLED=true
