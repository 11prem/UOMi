APP_NAME=UOMi
DEBUG=false

# SQLite for development. PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./uomi.db

# Browser origins allowed to call the API (the Expo web build), comma separated.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# REQUIRED. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Sign-in session ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=10

# --- Sign-in lockout ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Forgot password ---
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=3
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_SESSION_TIMEOUT_MINUTES=10

DEFAULT_COUNTRY_CODE=+91
DEFAULT_CURRENCY=INR

# console = the text message is printed in the server output (development)
SMS_BACKEND=console

# true = the API process sends payment reminders once a day (days 3, 5, 7 and 10 after a share is accepted)
REMINDERS_ENABLED=true
